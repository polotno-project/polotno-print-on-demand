# Printful: private token for a "Manual order platform / API" store
# https://developers.printful.com/tokens
PRINTFUL_TOKEN=
# Only needed for account-level tokens
PRINTFUL_STORE_ID=

# Printify: personal access token, https://printify.com/app/account/api
PRINTIFY_TOKEN=
# Optional, defaults to the account's first shop
PRINTIFY_SHOP_ID=

# Lulu (optional, for the cover check route): sandbox keys from
# https://developers.sandbox.lulu.com/user-profile/api-keys
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# Teemill: the public key from your Teemill developer settings
TEEMILL_PUBLIC_KEY=

# Fourthwall: shop API credentials (username and password)
FOURTHWALL_USERNAME=
FOURTHWALL_PASSWORD=

# This server's public URL. Printful downloads print files from it.
PUBLIC_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5173
